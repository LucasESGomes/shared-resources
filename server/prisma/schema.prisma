generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["booking"]
}


enum UserStatus {
  active
  inactive

  @@map("user_status")
  @@schema("booking")
}

enum UserRole {
  user
  admin

  @@map("user_role")
  @@schema("booking")
}

enum ResourcesType {
  room
  equipment

  @@map("resources_type")
  @@schema("booking")
}

enum ReservationStatus {
  active
  inactive

  @@map("reservation_status")
  @@schema("booking")
}

enum ResourceStatus {
  active
  inactive

  @@map("resource_status")
  @@schema("booking")
}


model refresh_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([token_hash], map: "idx_refresh_tokens")
  @@schema("booking")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reservations {
  id                String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String?                            @db.Uuid
  resource_id       String?                            @db.Uuid
  start_time        DateTime                           @db.Timestamptz(6)
  end_time          DateTime                           @db.Timestamptz(6)
  status            ReservationStatus                  @default(active)
  quantity_reserved Int?                               @default(1)
  idempotency_key   String                             @unique @db.Uuid
  created_at        DateTime?                          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?                          @default(now()) @db.Timestamptz(6)
  resources         resources?                         @relation(fields: [resource_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users?                             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([resource_id, start_time, end_time], map: "idx_reservations_resource_time")
  @@index([user_id], map: "idx_reservations_user")
  @@schema("booking")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model resources {
  id           String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String                          @db.VarChar(100)
  quantity     Int
  type         ResourcesType                   @default(room) 
  location     String?
  status       ResourceStatus                  @default(active)
  created_at   DateTime?                       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?                       @default(now()) @db.Timestamptz(6)
  reservations reservations[]

  @@schema("booking")
}

model users {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String                      @db.VarChar(100)
  email          String                      @unique @db.VarChar(255)
  password_hash  String
  role           UserRole                    @default(user) 
  photo_url      String?
  isActive       UserStatus                  @map("isactive") @default(active)
  created_at     DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?                   @default(now()) @db.Timestamptz(6)
  refresh_tokens refresh_tokens[]
  reservations   reservations[]

  @@schema("booking")
}
